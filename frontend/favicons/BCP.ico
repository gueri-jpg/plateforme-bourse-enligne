    <div class="besoin-aide js-need-help">
        <span> ​​​Besoin d'aide ? </span>
        <span>
            <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-phone">
                <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-phone" />
            </svg>
        </span>
