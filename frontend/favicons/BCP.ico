			<div WebPartID="b04afaa4-b9a5-4271-ae16-737ed7199544" HasPers="false" id="WebPartWPQ5" width="100%" class="ms-WPBody noindex " allowDelete="false" style="" ><div class="ms-rtestate-field"><!DOCTYPE html>
<html>

<head>
	<meta http-equiv="Content-Type" content="text/html;charset=UTF-8">
</head>

<body>
    <div class="bg-gray">

        <div class="title title--small text-center pt-4">
            NOTRE GROUPE
        </div>

        <div class="title title--bloc text-center">
            UNE BANQUE INTERNATIONALE
        </div>

        <div class="pt-md-7 pt-2 pb-md-9 pb-0">
            <div class="container notre-groupe-container">
                <div class="row">
                    <div class="col-12 col-md-6 p-0">
                        <a class="notre-groupe" href="https://www.groupebcp.com/fr/Pages/presence-en-afrique.aspx">
                            <figure>
                                <img src="/SiteAssets/img/groupe-afrique.png" alt="">
                            </figure>

                            <div class="wrapper-absolute">
                                <h3 class="notre-groupe_title">
                                    <span>En</span>
                                    Afrique
                                </h3>
                                <p class="notre-groupe_link" href="https://www.groupebcp.com/fr/Pages/presence-en-afrique.aspx">
                                    Découvrir
                                </p>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-md-6 p-0">
                        <a class="notre-groupe" href="https://www.groupebcp.com/fr/Pages/presence-en-europe.aspx">
                            <figure>
                                <img src="/SiteAssets/img/groupe-europe.png" alt="">
                            </figure>

                            <div class="wrapper-absolute">
                                <h3 class="notre-groupe_title">
                                    <span>En</span>
                                    Europe
                                </h3>
                                <p class="notre-groupe_link" href="https://www.groupebcp.com/fr/Pages/presence-en-europe.aspx">
                                    Découvrir
                                </p>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-md-6 p-0">
                        <a class="notre-groupe" href="https://www.groupebcp.com/fr/Pages/presence-au-moyen-orient.aspx">
                            <figure>
                                <img src="/SiteAssets/img/groupe-orient.png" alt="">
                            </figure>

                            <div class="wrapper-absolute">
                                <h3 class="notre-groupe_title">
                                    <span>Au</span>
                                    Moyen-Orient
                                </h3>
                                <p class="notre-groupe_link" href="https://www.groupebcp.com/fr/Pages/presence-au-moyen-orient.aspx">
                                    Découvrir
                                </p>
                            </div>
                        </a>
