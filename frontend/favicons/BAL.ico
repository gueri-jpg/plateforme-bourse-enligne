ntials\"}],[\"$\",\"meta\",\"5\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"6\",{\"name\":\"mobile-web-app-capable\",\"content\":\"yes\"}],[\"$\",\"link\",\"7\",{\"rel\":\"canonical\",\"href\":\"https://snaptaskapp.ai\"}],[\"$\",\"link\",\"8\",{\"rel\":\"alternate\",\"hrefLang\":\"en\",\"href\":\"https://snaptaskapp.ai\"}],[\"$\",\"link\",\"9\",{\"rel\":\"alternate\",\"hrefLang\":\"fr\",\"href\":\"https://snaptaskapp.ai/fr\"}],[\"$\",\"link\",\"10\",{\"rel\":\"alternate\",\"hrefLang\":\"ar\",\"href\":\"https://snaptaskapp.ai/ar\"}],[\"$\",\"link\",\"11\",{\"rel\":\"alternate\",\"hrefLang\":\"es\",\"href\":\"https://snaptaskapp.ai/es\"}],[\"$\",\"link\",\"12\",{\"rel\":\"alternate\",\"hrefLang\":\"no\",\"href\":\"https://snaptaskapp.ai/no\"}],[\"$\",\"meta\",\"13\",{\"name\":\"apple-mobile-web-app-capable\",\"content\":\"yes\"}],[\"$\",\"meta\",\"14\",{\"name\":\"apple-mobile-web-app-title\",\"content\":\"SnapTask\"}],[\"$\",\"meta\",\"15\",{\"name\":\"apple-mobile-web-app-status-bar-style\",\"content\":\"black-translucent\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:title\",\"content\":\"SnapTask — Professional documents in 2 minutes\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:description\",\"content\":\"Generate CVs, invoices, quotes, letters and official documents in a few clicks. Professional quality, unbeatable prices.\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:url\",\"content\":\"https://snaptaskapp.ai\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:site_name\",\"content\":\"SnapTask\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:locale\",\"content\":\"en_US\"}],[\"$\",\"meta\",\"21\",{\"property\":\"og:image\",\"content\":\"https://snaptaskapp.ai/og-image.png\"}],[\"$\",\"meta\",\"22\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"23\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"24\",{\"property\":\"og:image:alt\",\"content\":\"SnapTask — Documents professionnels en 2 minutes\"}],[\"$\",\"meta\",\"25\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"26\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"27\",{\"name\":\"twitter:title\",\"content\":\"SnapTask — Professional documents in 2 minutes\"}],[\"$\",\"meta\",\"28\",{\"name\":\"twitter:description\",\"content\":\"Generate CVs, invoices, quotes, letters and official documents in a few clicks. Professional quality, unbeatable prices.\"}],[\"$\",\"meta\",\"29\",{\"name\":\"twitter:image\",\"content\":\"https://snaptaskapp.ai/og-image.png\"}],[\"$\",\"link\",\"30\",{\"rel\":\"icon\",\"href\":\"/favicon.png\"}],[\"$\",\"link\",\"31\",{\"rel\":\"apple-touch-icon\",\"href\":\"/snaptask-app-logo.png\"}],[\"$\",\"meta\",\"32\",{\"name\":\"next-size-adjust\"}]]\n"])</script><script>self.__next_f.push([1,"a:null\n"])</script><script>self.__next_f.push([1,"14:I[49906,[\"6307\",\"static/chunks/6307-070d0f3b58a538f0.js\",\"7923\",\"static/chunks/7923-692c6f91d096a17d.js\",\"4908\",\"static/chunks/4908-148e595313fb7c60.js\",\"1203\",\"static/chunks/app/%5Blocale%5D/layout-de937998e30c7e2c.js\"],\"default\"]\n18:I[16615,[\"6307\",\"static/chunks/6307-070d0f3b58a538f0.js\",\"7923\",\"static/chunks/7923-692c6f91d096a17d.js\",\"4908\",\"static/chunks/4908-148e595313fb7c60.js\",\"1203\",\"static/chunks/app/%5Blocale%5D/layout-de937998e30c7e2c.js\"],\"default\"]\n1a:I[6861,[\"6307\",\"static/chunks/6307-070d0f3b58a538f0.js\",\"7923\",\"static/chunks/7923-692c6f91d096a17d.js\",\"4908\",\"static/chunks/4908-148e595313fb7c60.js\",\"1203\",\"static/chunks/app/%5Blocale%5D/layout-de937998e30c7e2c.js\"],\"default\"]\n15:T9e9,"])</script><script>self.__next_f.push([1,"1. WEBSITE PUBLISHER\n\nThe SnapTask website (snaptaskapp.ai) is published by iGreen AS, a company registered in Norway under organization number 996197522, with registered office at Holandsgata Pn., 0655 Oslo, Norway.\nContact: hello@snaptaskapp.ai\n\n2. PURPOSE OF THE SERVICE\n\nSnapTask is an online service for the automated generation of documents (letters, guides, forms) using artificial intelligence. The generated documents are intended for private use. They do not replace official forms or professional advice (legal, tax, medical).\n\n3. ACCEPTANCE OF TERMS\n\nUsing the service implies full acceptance of these Terms. Users declare they are at least 18 years old or have parental authorization.\n\n4. SERVICES OFFERED\n\nSnapTask offers personalized document generation through unit payment or prepaid credits. Generated documents are delivered in PDF or text format. Delivery is immediate after payment confirmation.\n\n5. PAYMENT\n\nPayments are processed by Stripe. SnapTask does not store any banking data. Prices displayed are in euros, all taxes included for European users. No subscription is required: payments are per unit.\n\n6. RIGHT OF WITHDRAWAL\n\nIn accordance with EU Directive 2011/83/EU, the right of withdrawal does not apply to digital content provided on a non-tangible medium where execution has begun with the consumer's express consent. By validating payment, the user expressly acknowledges waiving their right of withdrawal for documents generated and delivered immediately.\n\n7. LIABILITY\n\nSnapTask uses all necessary means to provide a quality service, but cannot guarantee the completeness or regulatory compliance of generated documents. The user is solely responsible for verifying the information they provide and the compliance of generated documents with their situation. SnapTask cannot be held responsible for direct or indirect consequences related to the use of generated documents.\n\n8. INTELLECTUAL PROPERTY\n\nThe site's elements (logo, design, code, brand) are the exclusive property of iGreen AS. Generated documents become the property of the user after payment.\n\n9. PERSONAL DATA\n\nSee our Privacy Policy and GDPR page.\n\n10. MODIFICATION OF TERMS\n\nSnapTask reserves the right to modify these Terms at any time. Modifications take effect upon publication on the site.\n\n11. APPLICABLE LAW\n\nThese Terms are governed by Norwegian law. Any dispute falls under the exclusive jurisdiction of the courts of Oslo, Norway, except where mandatory consumer protection law applicable to the consumer provides otherwise."])</script><script>self.__next_f.push([1,"16:T86c,"])</script><script>self.__next_f.push([1,"1. DATA CONTROLLER\n\niGreen AS\nOrganization number: 996197522\nAddress: Holandsgata Pn., 0655 Oslo, Norway\nContact: hello@snaptaskapp.ai\n\n2. DATA COLLECTED\n\nWe collect only the data strictly necessary for the service:\n- Email and name (via Google OAuth at signup)\n- Form data (name, address, document content)\n- Payment data (processed by Stripe, never stored by SnapTask)\n- Technical data (IP address, browser, language) for security and anonymous statistics\n\n3. PURPOSES OF PROCESSING\n\nYour data is used exclusively to:\n- Execute the service (generate requested documents)\n- Manage your account and order history\n- Process payments\n- Improve the service (anonymized statistics)\n- Communicate with you about your order\n\n4. LEGAL BASIS\n\nThe processing of your data is based on:\n- Performance of the contract (generating the ordered document)\n- Your consent (account creation, marketing communications)\n- Our legitimate interest (security, fraud prevention)\n- Our legal obligations (accounting, taxation)\n\n5. DATA SHARING\n\nYour data is only shared with subprocessors necessary for the service:\n- Anthropic (AI content generation)\n- Stripe (payment processing)\n- PDFShift (PDF generation)\n- Vercel and Railway (hosting)\n- Google (authentication)\n\nAll our subprocessors are contractually committed to GDPR compliance.\n\n6. RETENTION PERIOD\n\n- User account: as long as the account is active\n- Generated documents: 12 months\n- Billing data: 10 years (legal obligation)\n- Technical logs: 12 months maximum\n\n7. YOUR RIGHTS\n\nYou have the following rights: access, rectification, deletion, portability, objection, restriction of processing. To exercise these rights: hello@snaptaskapp.ai\n\nYou can also file a complaint with the Norwegian Data Protection Authority (Datatilsynet).\n\n8. COOKIES\n\nWe only use cookies essential for the service to function (session, authentication). No advertising or third-party tracking cookies are placed.\n\n9. SECURITY\n\nWe implement appropriate technical and organizational measures to protect your data: HTTPS encryption, secure sessions, restricted data access.\n\n10. CONTACT\n\nFor any questions regarding your data: hello@snaptaskapp.ai"])</script><script>self.__next_f.push([1,"17:T7eb,SnapTask, published by iGreen AS, fully complies with the General Data Protection Regulation (GDPR - EU 2016/679) and the Norwegian Personal Data Act (Personopplysningsloven).\n\n1. YOUR GDPR RIGHTS\n\nRight of access: Obtain a copy of the data we hold about you.\nRight to rectification: Correct inaccurate data via your profile or by email.\nRight to erasure: Request deletion of your account and data.\nRight to portability: Receive your data in a structured format.\nRight to object: Refuse certain processing (marketing, profiling).\nRight to restriction: Request temporary suspension of processing.\n\n2. HOW TO EXERCISE YOUR RIGHTS\n\nSend your request to hello@snaptaskapp.ai specifying:\n- Your identity (account email)\n- The right you wish to exercise\n- The details of your request\n\nWe will respond within 30 days maximum, in accordance with GDPR.\n\n3. ACCOUNT DELETION\n\nYou can request the complete deletion of your account at any time. All your personal data will be deleted within 30 days, except for data retained under legal obligations (invoices for 10 years).\n\n4. SUBPROCESSORS\n\nWe work exclusively with GDPR-compliant subprocessors:\n- Anthropic (United States, Standard Contractual Clauses)\n- Stripe (Ireland, GDPR-compliant)\n- PDFShift (France, GDPR-compliant)\n- Google (Ireland, GDPR-compliant)\n- Vercel (United States, Standard Contractual Clauses)\n- Railway (United States, Standard Contractual Clauses)\n\n5. NON-EU TRANSFERS\n\nSome subprocessors are located outside the European Union. These transfers are governed by Standard Contractual Clauses (SCC) approved by the European Commission, ensuring an equivalent level of protection.\n\n6. SUPERVISORY AUTHORITY\n\nIn case of dispute, you can contact the Norwegian Data Protection Authority:\nDatatilsynet\nP.O. Box 458 Sentrum\n0105 Oslo, Norway\nhttps://www.datatilsynet.no\n\nIf you reside in another EU country, you can contact your country's data protection authority (CNIL in France, AEPD in Spain, etc.).\n\n7. DPO CONTACT\n\nFor any GDPR-related questions: hello@snaptaskapp.ai19:[\"locale\","])</script><script>self.__next_f.push([1,"\"en\",\"d\"]\n"])</script><script>self.__next_f.push([1,"d:[\"$\",\"$L14\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"meta\":{\"title\":\"SnapTask — One task. One tap. Done.\",\"description\":\"AI-powered document generator for professionals\"},\"userMenu\":{\"login\":\"Log in\",\"signup\":\"Sign up\",\"myAccount\":\"My account\",\"myProfile\":\"My profile\",\"myOrders\":\"My orders\",\"logout\":\"Log out\",\"openMenu\":\"Open user menu\"},\"account\":{\"title\":\"My account\",\"loading\":\"Loading...\",\"myOrders\":\"My orders\",\"myOrdersHint\":\"Find your generated documents\",\"myProfile\":\"My profile\",\"myProfileHint\":\"Manage your personal info\",\"profile\":{\"title\":\"My profile\",\"editTitle\":\"Edit my profile\",\"edit\":\"Edit\",\"save\":\"Save\",\"saving\":\"Saving...\",\"saved\":\"Saved ✓\",\"errorLoad\":\"Failed to load\",\"email\":\"Email\",\"firstName\":\"First name\",\"lastName\":\"Last name\",\"address\":\"Address\",\"postalCode\":\"Postal code\",\"city\":\"City\",\"phone\":\"Phone\",\"autoFillHint\":\"Your info is used to pre-fill forms.\"},\"backHome\":\"Back to home\",\"backHomeHint\":\"SnapTask homepage\",\"allTasks\":\"All tasks\",\"all