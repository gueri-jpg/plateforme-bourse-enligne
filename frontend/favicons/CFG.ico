<div class="floating-buttons-wrapper">
<div class="floating-buttons" id="floatingButtons">
<!-- Boutons par défaut -->
<a href="/particuliers/devenir-client/?utm_source=sitecfgbank&utm_medium=floatbutton&utm_campaign=T22021" class="floating-button" title="Devenir client" tooltip="Devenir client">
<i class="fa-solid fa-user-plus"></i>
</a>
