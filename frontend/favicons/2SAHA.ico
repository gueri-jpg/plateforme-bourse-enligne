        <div class="icon-box" style="background-color: #0E64AF;">
            <a href="https://agences.sanlam.ma/fr" target="_blank" style="text-decoration: none; display: flex; align-items: center;">
                <img src="/static/images/localisation-icon.png" width="25" height="25" alt="Localiser un agent" class="icon" />
                <span class="description1" style="color: #FFF; margin-left: 15px;">Localiser un agent</span>
            </a>
        </div>
    </div>
    <!-- Icône Informations -->
