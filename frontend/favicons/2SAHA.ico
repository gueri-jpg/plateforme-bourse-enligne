<div class="footer-glass-pill" id="navPill">
    <span class="footer-pill-close" id="closePill"></span>
    <a href="https://agences.sanlam.ma/fr" target="_blank" class="footer-pill-item" style="--c:#0E64AF;">
      <span class="footer-pill-circle">
        <img src="/static/images/localisation-icon.png" width="23" height="23" alt="Agent">
      </span>
      <span class="footer-pill-label">Agent</span>
    </a>
    <a href="/fr/contact/" class="footer-pill-item" style="--c:#0E4472;">
      <span class="footer-pill-circle">
        <img src="/static/images/info-icon.png" width="23" height="23" alt="Infos">
      </span>
      <span class="footer-pill-label">Infos</span>
    </a>
    <button class="footer-pill-item footer-pill-center" style="--c:#4CC1B2;" id="openContacts">
      <span class="footer-pill-circle">
        <img src="/static/images/phone-icon.png" width="27" height="27" alt="Contact">
        <span class="footer-pill-badge"></span>
      </span>
      <span class="footer-pill-label">Contact</span>
    </button>
    <a href="/fr/reclamation/" class="footer-pill-item" style="--c:#F4A611;">
      <span class="footer-pill-circle">
        <img src="/static/images/reclamation-icon.png" width="23" height="23" alt="Réclamer">
      </span>
      <span class="footer-pill-label">Réclamer</span>
    </a>
    <a href="/fr/faq/" class="footer-pill-item" style="--c:#B36CA4;">
      <span class="footer-pill-circle">
        <img src="/static/images/question-icon.png" width="23" height="23" alt="FAQ">
      </span>
      <span class="footer-pill-label">FAQ</span>
    </a>
</div>

<button class="trigger-button radial" id="togglePill">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
      <circle cx="12" cy="4" r="2"/>
      <circle cx="12" cy="12" r="2"/>
      <circle cx="12" cy="20" r="2"/>
      <circle cx="4" cy="12" r="2"/>    
      <circle cx="20" cy="12" r="2"/>
    </svg>
  </button>
  <!-- <button class="trigger-button arrow-right" id="togglePill">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </button> -->

<script>
    
    document.getElementById('togglePill').addEventListener('click', function() {
      document.getElementById('navPill').classList.add('visible');
    });
    
    document.getElementById('closePill').addEventListener('click', function(e) {
      e.stopPropagation(); 
      document.getElementById('navPill').classList.remove('visible');
    });
   
   </script>
  <!-- Popup Contacts utiles Mobile -->
<div id="contactPopupMobile" style="display: none;">
