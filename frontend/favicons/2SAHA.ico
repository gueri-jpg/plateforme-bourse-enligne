    <style>
        .whatsapp-float {
        position: fixed;
        left: 20px;
        bottom: 15px;
        z-index: 9999;
        width: 55px;
        height: 55px;
        }

        .whatsapp-float a {
        display: flex;
        width: 100%;
        height: 100%;
        background: #25D366;
        border-radius: 50%;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(0,0,0,.25);
        transition: all .3s ease;
        }

        .whatsapp-float a:hover {
        transform: scale(1.08);
        }

        .whatsapp-float img {
        width: 28px;
        height: 28px;
        }

        @media (max-width: 768px) {
        .whatsapp-float {
            left: 15px;
            bottom: 10px;
            width: 40px;
            height: 40px;
        }
        .whatsapp-float img {
            width: 20px;
            height: 20px;
        }
        }
