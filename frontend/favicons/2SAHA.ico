  z-index: 2;
}

.footer-pill-close::before {
  content: "×";
}
    /* Style pour le bouton déclencheur */
    .trigger-button {
      position: fixed;
      left: 15px;
      bottom: 60px;
      z-index: 15000;
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #4CC1B2 70%, #B36CA4 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2.5px 8px rgba(76,193,178,0.3);
      border: none;
      cursor: pointer;
    }
    
    .trigger-button img {
      width: 25px;
      height: 25px;
    }
 
    
    /* Cache le bouton trigger sur desktop */
    @media (min-width: 768px) {
      .trigger-button { display: none !important; }
    }
    
    @media (max-width: 767px) {
      .cta-desktop { display: none !important; }
      
      /* Barre cachée par défaut */
      .footer-glass-pill { 
        display: none;
        position: fixed;
        left: 0;
        right: 0;
        bottom: 17px;
        z-index: 14000;
        background: rgba(255,255,255,0.93);
        box-shadow: 0 8px 38px 2px rgba(51,80,120,0.15), 0 1.5px 8px 0 rgba(76,193,178,0.12);
        border-radius: 38px;
        width: 95vw;
        max-width: 415px;
        margin: 0 auto;
        padding: 7px 8px 2px 8px;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-end;
        gap: 0vw;
        backdrop-filter: blur(14px);
        border: 1px solid rgba(215,235,235,0.20);
        transition: box-shadow 0.16s;
      }
      
      /* Barre visible quand la classe 'visible' est ajoutée */
      .footer-glass-pill.visible {
        display: flex !important;
      }
    
      /* Cache le bouton quand la barre est visible */
      .footer-glass-pill.visible + .trigger-button {
        display: none !important;
      }
      
      .footer-pill-item {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: none;
        border: none;
        color: #28354d;
        text-decoration: none;
        font-size: 11px;
        padding: 0;
        transition: color 0.17s;
        position: relative;
        min-width: 52px;
        max-width: 68px;
        z-index: 1;
      }
      .footer-pill-item:active .footer-pill-circle,
      .footer-pill-item:focus .footer-pill-circle {
        background: #222 !important;
      }
      .footer-pill-circle {
        width: 44px;
        height: 44px;
        background: var(--c, #d4f5ef);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 3px;
        box-shadow: 0 2.5px 8px rgba(76,193,178,0.09);
        transition: background 0.16s, box-shadow 0.15s;
        position: relative;
      }
      .footer-pill-circle-main {
        box-shadow:
          0 0 0 0 #3db7aa33,
          0 4px 18px 7px #ffffffaa;
        background: linear-gradient(135deg, #4CC1B2 70%, #B36CA4 100%);
        width: 56px;
        height: 56px;
        margin-bottom: 1px;
      }
      .footer-pill-center {
        margin-top: -18px;
        z-index: 3;
        min-width: 69px;
        max-width: 75px;
      }
      .footer-pill-badge {
        position: absolute;
        top: 9px;
        right: 9px;
        width: 11px;
        height: 11px;
        background: #ff5966;
        border-radius: 50%;
        border: 2px solid #fff;
        display: none;
        box-shadow: 0 1px 8px #ff596688;
        content: '';
      }
      .footer-pill-label {
        font-size: 11px;
        font-weight: 500;
        color: #27314b;
        letter-spacing: 0.04em;
        text-align: center;
        margin-top: 1.5px;
        text-transform: uppercase;
      }
    }
    @media (min-width: 768px) {
      .footer-glass-pill { display: none !important; }
    }
    </style>
