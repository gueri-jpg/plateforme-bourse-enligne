<script>
window.addEventListener('load', function() {
    const urlPath = window.location.pathname;
    
    if(urlPath.includes('sanlam-private-investment')) {
        setTimeout(function() {
            $('.type-particulier').removeClass('active');
            $('.type-professionnels').removeClass('active');
            $('.type-sanlam-private').addClass('active');
            $('.contactHeader').addClass('hide');
            $('.contactHeaderPro').addClass('hide');
        }, 100);
    }
});
</script>
