                <div class="phone-number" style="display: none; color: #33005C; font-size: 12px; text-decoration: none;">
                    <a href="tel:3434" style="color: #000;" class="phone-link">Appeler le 34 34</a>
                </div>
            </div>

            <div class="contact-item" style="border: 1px solid #6E4091; border-radius: 2px; margin-bottom: 5px; padding: 7px;">
